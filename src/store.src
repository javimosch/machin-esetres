// store.src — the object store's core: buckets, sha256-deduped objects, a
// SQLite index per bucket, a plain SQLite registry of bucket tokens.
//
// Every function here is shared by the CLI (main.src) and the HTTP server
// (server.src) — and NONE of them call die()/exit(). A shared function that
// exits would kill the whole daemon on one bad request; only the CLI-only
// wrappers in main.src (and cmd_bucket_create, which has no HTTP path in
// Phase 1) are allowed to die().
//
// Layout on disk:
//   <data>/buckets.db                                  bucket name -> token
//   <data>/<bucket>/index.db                           key -> sha, blobs -> refcount
//   <data>/<bucket>/objects/<sha[0:2]>/<sha[2:4]>/<sha> the blob, content-addressed

type ShaRow struct { sha string }
type ObjMeta struct { sha string  content_type string  created_at int }
type BlobRow struct { sha string  refcount int }
type BucketRow struct { name string  token string  created_at int  max_bytes int }
type TokenRow struct { token string }
type QuotaRow struct { max_bytes int }
type SumRow struct { total int }

func bucket_dir(data, name) (p) { p = data + "/" + name }

func blob_shard_path(bdir, sha) (p) {
    p = bdir + "/objects/" + substr(sha, 0, 2) + "/" + substr(sha, 2, 4) + "/" + sha
}

// mkdir_p creates every missing directory along path (mkdir is single-level).
func mkdir_p(path) {
    if path == "" { return }
    if is_dir(path) { return }
    prefix := ""
    rest := path
    if has_prefix(path, "/") { prefix = "/"  rest = substr(path, 1, len(path)) }
    cur := prefix
    for _, part := range split(rest, "/") {
        if part == "" { continue }
        if cur == "" || cur == "/" { cur = cur + part } else { cur = cur + "/" + part }
        if !is_dir(cur) { mkdir(cur) }
    }
}

func mask_token(s) (m) {
    m = "…"
    if len(s) > 8 { m = substr(s, 0, 3) + "…" + substr(s, len(s) - 4, len(s)) }
}

// shq single-quotes a value for safe use in a shell command line.
func shq(s) (q) {
    q = "'" + replace(s, "'", "'\\''") + "'"
}

// esetres_min_free_bytes is the global floor below which storing is refused
// — same idea and env-var-naming convention as poche-resend-webmail's own
// BLOB_MIN_FREE_BYTES, so a mailbox filling one storage backend can't take
// the whole host down with it either way.
func esetres_min_free_bytes() (n) {
    n = 512 * 1024 * 1024
    v := env("ESETRES_MIN_FREE_BYTES")
    if v != "" { n = parse_int(v) }
}

// disk_free_bytes shells out to `df` — machin has no statfs/disk-space
// builtin. ok=0 on any failure (missing df, unreadable path); callers treat
// that as "couldn't check" and don't block the write on it, matching
// blobstore.go's own "best-effort" framing for the same check.
func disk_free_bytes(path) (n, ok) {
    n = 0
    ok = 0
    code, out, err := exec("df -B1 --output=avail " + shq(path) + " | tail -1")
    if code != 0 || err != "" { return }
    v := trim(out)
    if v == "" { return }
    n = parse_int(v)
    ok = 1
}

// resolve_bucket_token looks up a bucket's bearer token — the HTTP layer's auth check.
func resolve_bucket_token(data, name) (token, ok) {
    token = ""
    ok = 0
    if !is_dir(data) { return }
    reg := sqlite_open(data + "/buckets.db")
    rows := sqlite_query(reg, "SELECT token FROM buckets WHERE name=?", []string{name})
    sqlite_close(reg)
    list := parse(rows, []TokenRow{})
    if len(list) > 0 { token = list[0].token  ok = 1 }
}

// bucket_create makes a bucket dir + its index tables, mints a token, and
// registers it. CLI-only in Phase 1 (no HTTP route creates buckets), so it is
// allowed to be the one "core" function that's fine to wrap with die() at the
// call site rather than threading an ok flag through — nothing else calls it.
// bucket_create makes a bucket dir + its index tables, mints a token, and
// registers it. max_bytes is a per-bucket cap on total blob bytes (0 =
// unlimited — see the "cannot grow indefinitely" rationale on obj_put).
func bucket_create(data, name, max_bytes) (token, ok) {
    ok = 0
    token = ""
    bdir := bucket_dir(data, name)
    if is_dir(bdir) { return }
    mkdir_p(bdir + "/objects")
    idxdb := sqlite_open(bdir + "/index.db")
    sqlite_exec(idxdb, "CREATE TABLE IF NOT EXISTS objects(key TEXT PRIMARY KEY, sha TEXT, size INTEGER, content_type TEXT, created_at INTEGER)")
    sqlite_exec(idxdb, "CREATE TABLE IF NOT EXISTS blobs(sha TEXT PRIMARY KEY, refcount INTEGER, size INTEGER)")
    sqlite_close(idxdb)
    token = to_hex(rand_bytes(16))
    reg := sqlite_open(data + "/buckets.db")
    sqlite_exec(reg, "CREATE TABLE IF NOT EXISTS buckets(name TEXT PRIMARY KEY, token TEXT, created_at INTEGER, max_bytes INTEGER)")
    sqlite_exec(reg, "INSERT INTO buckets(name, token, created_at, max_bytes) VALUES(?, ?, ?, ?)", []string{name, token, str(now()), str(max_bytes)})
    sqlite_close(reg)
    ok = 1
}

// bucket_set_quota changes an existing bucket's cap (0 = unlimited).
func bucket_set_quota(data, name, max_bytes) (ok) {
    ok = 0
    if !is_dir(bucket_dir(data, name)) { return }
    reg := sqlite_open(data + "/buckets.db")
    sqlite_exec(reg, "UPDATE buckets SET max_bytes=? WHERE name=?", []string{str(max_bytes), name})
    sqlite_close(reg)
    ok = 1
}

func bucket_quota(data, name) (max_bytes, ok) {
    max_bytes = 0
    ok = 0
    reg := sqlite_open(data + "/buckets.db")
    rows := sqlite_query(reg, "SELECT max_bytes FROM buckets WHERE name=?", []string{name})
    sqlite_close(reg)
    list := parse(rows, []QuotaRow{})
    if len(list) > 0 { max_bytes = list[0].max_bytes  ok = 1 }
}

// bucket_bytes_used sums actual blob bytes (not per-key sizes — two keys
// sharing a deduped blob must not double-count it, or the quota would
// punish dedup instead of rewarding it).
func bucket_bytes_used(data, name) (used) {
    used = 0
    bdir := bucket_dir(data, name)
    if !is_dir(bdir) { return }
    idxdb := sqlite_open(bdir + "/index.db")
    rows := sqlite_query(idxdb, "SELECT COALESCE(SUM(size),0) AS total FROM blobs")
    sqlite_close(idxdb)
    list := parse(rows, []SumRow{})
    if len(list) > 0 { used = list[0].total }
}

func bucket_list_body(data) (body) {
    body = "\"buckets\":[]"
    if !is_dir(data) { return }
    reg := sqlite_open(data + "/buckets.db")
    sqlite_exec(reg, "CREATE TABLE IF NOT EXISTS buckets(name TEXT PRIMARY KEY, token TEXT, created_at INTEGER, max_bytes INTEGER)")
    rows := sqlite_query(reg, "SELECT name, token, created_at, max_bytes FROM buckets ORDER BY name")
    sqlite_close(reg)
    list := parse(rows, []BucketRow{})
    s := "\"buckets\":["
    i := 0
    for _, b := range list {
        if i > 0 { s = s + "," }
        used := bucket_bytes_used(data, b.name)
        s = s + "{\"name\":\"" + b.name + "\",\"token\":\"" + mask_token(b.token) + "\",\"created_at\":" + str(b.created_at) +
            ",\"used_bytes\":" + str(used) + ",\"max_bytes\":" + str(b.max_bytes) + "}"
        i = i + 1
    }
    s = s + "]"
    body = s
}

// blob_ref_dec decrements a blob's refcount, deleting the file + row at zero.
func blob_ref_dec(bdir, idxdb, sha) {
    rows := sqlite_query(idxdb, "SELECT refcount FROM blobs WHERE sha=?", []string{sha})
    list := parse(rows, []BlobRow{})
    if len(list) == 0 { return }
    nc := list[0].refcount - 1
    if nc <= 0 {
        sqlite_exec(idxdb, "DELETE FROM blobs WHERE sha=?", []string{sha})
        remove(blob_shard_path(bdir, sha))
    } else {
        sqlite_exec(idxdb, "UPDATE blobs SET refcount=? WHERE sha=?", []string{str(nc), sha})
    }
}

// obj_put stores raw under key in bucket, content-addressed by sha256. Two
// keys with identical bytes share one blob on disk (refcounted); overwriting
// a key re-points it and decrements the old blob's refcount. Never dies, so
// a bad request can't take the server down.
//
// ok: 0 = no such bucket, 1 = success, 2 = refused (bucket quota or global
// disk floor — see esetres_min_free_bytes/bucket_quota). Both caps are
// checked ONLY when a genuinely new blob needs disk space — a dedup hit
// (identical bytes already stored under another key in this bucket) costs
// nothing, so it always succeeds regardless of either cap; punishing dedup
// would reward re-uploading the same bytes under a fresh key instead.
func obj_put(data, bucket, key, raw, content_type) (sha, size, ok, err_msg) {
    ok = 0
    sha = ""
    size = 0
    err_msg = ""
    bdir := bucket_dir(data, bucket)
    if !is_dir(bdir) { err_msg = "no such bucket: " + bucket  return }
    idxdb := sqlite_open(bdir + "/index.db")
    sha = to_hex(sha256_bytes(raw))
    size = len(raw)

    old_rows := sqlite_query(idxdb, "SELECT sha FROM objects WHERE key=?", []string{key})
    old_list := parse(old_rows, []ShaRow{})
    old_sha := ""
    if len(old_list) > 0 { old_sha = old_list[0].sha }

    if old_sha != sha {
        exist_rows := sqlite_query(idxdb, "SELECT sha FROM blobs WHERE sha=?", []string{sha})
        exist_list := parse(exist_rows, []ShaRow{})
        if len(exist_list) == 0 {
            quota, qok := bucket_quota(data, bucket)
            if qok == 1 && quota > 0 {
                used := bucket_bytes_used(data, bucket)
                if used + size > quota {
                    sqlite_close(idxdb)
                    err_msg = "bucket quota exceeded: " + str(used) + " + " + str(size) + " > " + str(quota) + " bytes"
                    ok = 2
                    return
                }
            }
            free, fok := disk_free_bytes(bdir)
            if fok == 1 {
                floor := esetres_min_free_bytes()
                if free - size < floor {
                    sqlite_close(idxdb)
                    err_msg = "refusing to store: only " + str(free) + " bytes free on the storage volume (floor " + str(floor) + ")"
                    ok = 2
                    return
                }
            }
            shard := bdir + "/objects/" + substr(sha, 0, 2) + "/" + substr(sha, 2, 4)
            mkdir_p(shard)
            write_file_bytes(blob_shard_path(bdir, sha), raw)
            sqlite_exec(idxdb, "INSERT INTO blobs(sha, refcount, size) VALUES(?, 1, ?)", []string{sha, str(size)})
        } else {
            sqlite_exec(idxdb, "UPDATE blobs SET refcount = refcount + 1 WHERE sha=?", []string{sha})
        }
        if old_sha != "" { blob_ref_dec(bdir, idxdb, old_sha) }
        sqlite_exec(idxdb, "INSERT OR REPLACE INTO objects(key, sha, size, content_type, created_at) VALUES(?, ?, ?, ?, ?)",
            []string{key, sha, str(size), content_type, str(now())})
    } else {
        // identical content re-uploaded under the same key: no blob/refcount
        // change, but metadata (content-type) may have been updated.
        sqlite_exec(idxdb, "UPDATE objects SET content_type=?, created_at=? WHERE key=?", []string{content_type, str(now()), key})
    }
    sqlite_close(idxdb)
    ok = 1
}

type ObjStat struct { size int  content_type string }

// obj_stat is HEAD's backing query — metadata only, never reads the blob file.
func obj_stat(data, bucket, key) (size, ct, ok) {
    ok = 0
    ct = ""
    size = 0
    bdir := bucket_dir(data, bucket)
    if !is_dir(bdir) { return }
    idxdb := sqlite_open(bdir + "/index.db")
    rows := sqlite_query(idxdb, "SELECT size, content_type FROM objects WHERE key=?", []string{key})
    sqlite_close(idxdb)
    list := parse(rows, []ObjStat{})
    if len(list) == 0 { return }
    size = list[0].size
    ct = list[0].content_type
    ok = 1
}

// obj_get returns sha + created_at alongside the bytes (already known from
// the index lookup) so a caller building an ETag/Last-Modified doesn't have
// to re-hash the body or run a second query.
func obj_get(data, bucket, key) (raw, ct, sha, created_at, ok) {
    ok = 0
    ct = ""
    sha = ""
    created_at = 0
    raw = bytes("")
    bdir := bucket_dir(data, bucket)
    if !is_dir(bdir) { return }
    idxdb := sqlite_open(bdir + "/index.db")
    rows := sqlite_query(idxdb, "SELECT sha, content_type, created_at FROM objects WHERE key=?", []string{key})
    sqlite_close(idxdb)
    list := parse(rows, []ObjMeta{})
    if len(list) == 0 { return }
    sha = list[0].sha
    created_at = list[0].created_at
    raw = read_file_bytes(blob_shard_path(bdir, sha))
    ct = list[0].content_type
    ok = 1
}

func obj_delete(data, bucket, key) (ok) {
    ok = 0
    bdir := bucket_dir(data, bucket)
    if !is_dir(bdir) { return }
    idxdb := sqlite_open(bdir + "/index.db")
    rows := sqlite_query(idxdb, "SELECT sha FROM objects WHERE key=?", []string{key})
    list := parse(rows, []ShaRow{})
    if len(list) == 0 { sqlite_close(idxdb)  return }
    sqlite_exec(idxdb, "DELETE FROM objects WHERE key=?", []string{key})
    blob_ref_dec(bdir, idxdb, list[0].sha)
    sqlite_close(idxdb)
    ok = 1
}

// obj_list_body lists keys (optionally filtered by a literal prefix — a "%"
// or "_" in prefix is a SQL LIKE wildcard, not escaped in Phase 1).
func obj_list_body(data, bucket, prefix) (body, ok) {
    ok = 0
    body = ""
    bdir := bucket_dir(data, bucket)
    if !is_dir(bdir) { return }
    idxdb := sqlite_open(bdir + "/index.db")
    rows := ""
    if prefix == "" {
        rows = sqlite_query(idxdb, "SELECT key, sha, size, content_type, created_at FROM objects ORDER BY key")
    } else {
        rows = sqlite_query(idxdb, "SELECT key, sha, size, content_type, created_at FROM objects WHERE key LIKE ? ORDER BY key", []string{prefix + "%"})
    }
    sqlite_close(idxdb)
    body = "\"bucket\":\"" + bucket + "\",\"items\":" + rows
    ok = 1
}
